{
  "name": "PublicHoliday",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "name": {
      "type": "string"
    },
    "year": {
      "type": "number"
    },
    "state": {
      "type": "string",
      "default": "VIC"
    },
    "source": {
      "type": "string"
    }
  },
  "required": [
    "date",
    "name",
    "year"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}