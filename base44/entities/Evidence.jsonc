{
  "name": "Evidence",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string"
    },
    "scope_line_id": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "before",
        "finish",
        "clear"
      ]
    },
    "photo_uri": {
      "type": "string"
    },
    "captured_at": {
      "type": "string"
    },
    "received_at": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "accuracy": {
      "type": "number"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "scope_line_id",
    "stage",
    "photo_uri"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    }
  }
}